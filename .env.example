# Supabase connection — copy this file to .env and fill in your real values.
# Get these from: supabase.com → your project → Settings → API Keys
#
# NEVER commit .env to git. It is already in .gitignore.
#
# THESE TWO KEYS ARE NOT INTERCHANGEABLE — check the prefix before you paste.
# A key with the wrong value in the wrong slot below is a full-admin-access
# credential silently sitting under a "safe to expose" name (this happened
# once already, 2026-08-26 — the service-role value had been pasted into
# SUPABASE_ANON_KEY, and nothing broke or errored, it just quietly gave every
# caller admin access with no Row-Level-Security enforcement).
#
# SUPABASE_ANON_KEY ("publishable" key)
#   - Starts with: sb_publishable_
#   - What it can do: only what your Row-Level Security (RLS) policies allow.
#     Safe-ish to expose to a browser/frontend for that reason.
#   - Dashboard label: Settings → API Keys → "API Keys" tab → Publishable key
#
# SUPABASE_SERVICE_ROLE_KEY ("secret" key)
#   - Starts with: sb_secret_
#   - What it can do: everything — bypasses RLS entirely. Treat it like a
#     root password. Server-side / cron / backend code only. Never in
#     frontend code, never in a browser, never logged, never in a bug report.
#   - Dashboard label: Settings → API Keys → "API Keys" tab → Secret keys
#
# If you ever see an older-style value instead (a long string starting with
# `eyJ...`, not `sb_...`), that's a legacy JWT-based key — this project has
# already migrated off those, so a value in that format showing up here is a
# sign something old got pasted back in. Don't guess: open Settings → API Keys
# in the dashboard and copy the value fresh from the row actually labeled
# "Publishable key" or "Secret keys" — never reuse a value from memory, a
# password manager note, or an old .env backup.
#
# Rotating a key (e.g. after a leak): creating a new key in the dashboard does
# NOT automatically invalidate the old one — Supabase leaves both active until
# you explicitly delete the old row yourself (Settings → API Keys → the old
# key's "..." menu → Delete). After generating a replacement, always go back
# and delete the old key — the job isn't done until that old row is gone.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

APPFOLIO_CLIENT_ID=your-appfolio-client-id
APPFOLIO_CLIENT_SECRET=your-appfolio-client-secret

# Gmail (Google OAuth) — used by the AppFolio sync (projects/appfolio-sync/sync.js)
# to email peter@rinconmanagement.com and stephen@rinconmanagement.com when a
# nightly sync run fails or a row silently fails to save. Without these three
# set, that alert is only a console log line nobody watches — it does not
# reach anyone (found live, 2026-08-27).
#
# These are NOT new credentials to create. The exact same three values
# already exist and already work in production for
# projects/calendar-assistant/.env (send-morning-email.js, cron-scheduled on
# Sally — see deploy-to-sally.sh) — copy those three lines from that file
# into this repo's root .env (the same file this APPFOLIO_CLIENT_ID lives in;
# sync.js loads env vars from here, not from a .env inside
# projects/appfolio-sync/). If that file's values ever need to be rotated or
# regenerated instead, projects/calendar-assistant/get-gmail-token.js is the
# one-time OAuth flow that produces a fresh GOOGLE_REFRESH_TOKEN — it has to
# be run by hand by whoever holds the Google account login, never by an
# agent.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token

# Anthropic (Claude) API — used by the content engine (projects/content-engine)
# to draft blog posts, FAQs, reports, and social captions.
# Get this from: console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# YouTube Data API v3 — used by the viral trend scan (projects/content-engine/scan-viral-topics.js)
# to search for trending landlord-tenant content. Free tier, restricted to
# YouTube Data API v3 only.
# Get this from: console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=your-youtube-api-key-here

# LegiScan API — used by the legal-update scan (projects/content-engine, state-bill
# monitoring) to find newly chaptered California bills for Mason's legal review.
# Free tier: 30,000 queries/month.
# Get this from: legiscan.com/legiscan (free registration)
LEGISCAN_API_KEY=your-legiscan-api-key-here

# RentCast API — used by the rental analysis tool (projects/rental-analysis)
# to pull comparable rental listings and an automated rent estimate for a
# given address. Free tier: 50 requests/month (the tool uses 1 request per
# analysis run). Zillow and FlexMLS are the other two comp sources planned
# for this tool but are not built yet — see rental_comp_sources in the
# database and projects/rental-analysis/lib/sources.js.
# Get this from: developers.rentcast.io (free self-serve signup)
RENTCAST_API_KEY=your-rentcast-api-key-here

# Backblaze B2 — used by the security deposit disposition tool
# (projects/hub/security-deposit) to read move-in/move-out inspection photos
# out of the existing B2 photo archive. This key must be READ-ONLY and scoped
# to the single bucket this tool needs — the tool only ever looks at photos,
# it never writes or deletes one. This is also why a tenant's CCPA deletion
# request can't reach the actual photos through this tool (see SPEC.md's
# "Known Limitation" section) — a read-only key is what makes that guarantee
# real, not just a policy.
#
# Exact capabilities needed (nothing more): `listFiles` (folder/file-name
# indexing, lib/b2-client.js's listPhotoFolders/listFilesInFolder) AND
# `readFiles` (added 2026-08-21 for the targeted-photo-matching feature's
# downloadFileBytes() — see targeted-photo-matching-SPEC.md and the header
# comment in lib/b2-client.js). Never `writeFiles`, `deleteFiles`,
# `shareFiles`, or any account-level capability. B2 application keys can't
# have their capabilities edited in place after creation — widening this
# later means creating a brand-new key with the correct capability set,
# scoped to the same bucket, updating this value, confirming it works, then
# revoking the old key. Do this from the B2 web console yourself (Peter or
# whoever holds Rincon's B2 account login) — Scotty cannot log into the B2
# console and should never be asked to.
# Get these from: backblaze.com → My Account → App Keys → Add a New
# Application Key (see Scotty's setup notes for the exact steps).
B2_APPLICATION_KEY_ID=your-b2-application-key-id-here
B2_APPLICATION_KEY=your-b2-application-key-here
B2_BUCKET_NAME=your-b2-bucket-name-here

# Latchel — used by the maintenance-history tool (projects/hub/maintenance-history)
# to pull work orders, vendor assignments, and invoices instead of exporting them
# by hand. Latchel's API only offers one account-wide key with full read AND
# write access — there is no read-only or narrower-scoped option like the B2 key
# above. That means "this tool only ever reads" is enforced in this project's own
# code, not by the credential itself — worth knowing since it's a weaker
# guarantee than the read-only keys elsewhere in this file.
# Get this from your Latchel account's API/integrations settings, or from
# tech@latchel.com if it's not self-serve.
LATCHEL_API_KEY=your-latchel-api-key-here

# LATCHEL_WEBHOOK_SECRET — used by the Approval Briefing feature
# (projects/hub/approval-briefing) to verify that an inbound "Needs
# Approval" webhook delivery actually came from Latchel. NOT self-serve:
# Latchel's webhook registration is dashboard-only (Account Settings >
# Integrations > Webhook), and this specific secret has to be requested
# from tech@latchel.com — it is a separate, account-specific credential
# from LATCHEL_API_KEY above, sent as BOTH a `secret` field in the webhook's
# JSON body AND a duplicate `x-api-key` header. There is no IP allowlist on
# Latchel's side — this shared token is the only verification available,
# which is why approval-briefing/router.js checks both copies independently
# rather than trusting either alone. Until this is set, the webhook
# endpoint rejects every delivery (503) — the hourly reconciliation poll
# (CRON_SECRET-authenticated, not this key) is the backstop in the
# meantime, not a permanent substitute.
LATCHEL_WEBHOOK_SECRET=your-latchel-webhook-secret-here

# Aircall — used by the call stats tool (projects/hub/call-stats) to pull
# the previous day's calls and turn them into per-person, per-pod counts
# (calls, average length, missed calls, speed to answer). Statistics only —
# never a recording, transcript, or any other call content. Aircall's
# classic API issues one account-wide credential (API ID + API Token, HTTP
# Basic Auth) with no separate read-only variant confirmed available — that
# means "this tool only ever reads" is enforced in this project's own code
# (call-stats/lib/aircall-connector.js only ever issues GET requests), not
# by the credential itself, same weaker guarantee already flagged for the
# Latchel key above. Get these from Aircall's dashboard under
# Integrations & API > API Keys (Rincon's Aircall admin can generate one).
AIRCALL_API_ID=your-aircall-api-id-here
AIRCALL_API_TOKEN=your-aircall-api-token-here

# LeadSimple — used by the LeadSimple/Property Brain tool
# (projects/hub/leadsimple-property-brain) to pull process/workflow/task
# data into Property Brain's shared `claims` table. LeadSimple has a real
# REST API with its own key (found under Settings in their app — see
# training.leadsimple.com's "Find or rotate your REST API key" article),
# separate from the Zapier/webhook integrations most of their public docs
# cover. Note: LeadSimple already syncs property/tenant/owner/vendor data
# FROM AppFolio on its own, so that data is already covered elsewhere in
# this project — the real value here is the workflow/task data itself,
# not the property records; LeadSimple's own property records carry no
# AppFolio ID to join on, so this tool matches properties by address
# instead (see run-accuracy-test-sample.js).
#
# Phase 1 (schema only, no data read/written) is live — see
# supabase/migrations/20260825000000_leadsimple_property_brain_phase1.sql.
# Phase 2 (this key's first real use — a read-only connector, GET only,
# same "no generic request(method,path) helper" discipline as
# LATCHEL_API_KEY below) is scoped to `leadsimple_application_screening`
# only for now, per Asimov's spec-level pre-check
# (compliance/leadsimple-spec-governance-precheck.md) — Delinquency and
# the 74-type Operations domain are later phases, not built yet. Live-
# verified against Rincon's real account: LeadSimple has no per-process
# stage-history and no per-process filter on its /tasks endpoint — see
# projects/hub/leadsimple-property-brain/lib/leadsimple-connector.js's
# header comment for the full detail and how the extraction code handles
# both gaps. Rate limits: 100 requests/min AND 1,000 records/min, tracked
# separately — the records budget binds first at any per_page above ~17
# once you're paging every minute, which is why this tool's paginated
# pulls pace themselves in seconds, not just request count.
LEADSIMPLE_API_KEY=your-leadsimple-api-key-here

# CRON_SECRET — a shared password your own nightly jobs use to prove they're
# allowed to call your own tools (insurance-compliance, security-deposit,
# maintenance-history, and call-stats all check for it). Not from an outside
# company — you make this value up yourself, it just needs to be long and
# random. Referenced
# in code across multiple tools but was never actually set — nightly/scheduled
# runs for any of these tools will fail without it.
# Generate one yourself any time with: python3 -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET=your-own-random-value-here

# Web search for GENERAL_CITATIONS — used by the content engine's draft/revise
# steps (projects/content-engine/lib/draft.js, lib/revise.js) to look up real,
# current sources for non-legal facts (market stats, trend data) in pieces
# that have NO legal topics selected. Never available when legal grounding
# claims are present — see lib/draft.js's buildWebSearchTool(). Restricted to
# the allowlist in lib/general-citation-domains.js. Costs ~$0.01/search,
# capped at 2 searches per generation. Defaults to enabled if unset — set to
# "false" to turn it off (falls back to today's training-data-only behavior).
ENABLE_WEB_SEARCH_CITATIONS=true

# TIER_B_CONTEXTUAL_CHECK_ENABLED — the Content-Screening Precision Redesign's
# kill switch (projects/hub/maintenance-history/lib/content-check.js,
# content-screening-tier-redesign-SPEC.md). When enabled, six specific
# dictionary words (white, black, blind, diagnosis, diagnosed, too old/young)
# get a narrow AI recheck before flagging, instead of an automatic flag —
# reduces false positives, per real outside counsel's opinion and Asimov's/
# Mason's sign-off. Defaults to enabled if unset. Set to "false" to instantly
# revert those six terms to today's immediate-flag behavior, no redeploy
# needed. Deliberately set to "false" on initial deploy (2026-09-05) — the
# code is live but dormant until Peter explicitly decides to start the
# validation/rollout period described in the spec's Section 8.
TIER_B_CONTEXTUAL_CHECK_ENABLED=false
